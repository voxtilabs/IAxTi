{
  "name": "@iaxti/core",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@iaxti/telemetry": "workspace:*",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.0",
    "pg": "^8.23.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@iaxti/db": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-node": "^1.30.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.11.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
