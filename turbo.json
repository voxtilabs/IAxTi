{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "packages/modules/*/module.yaml"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^build"
      ],
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "IAXTI_ENV",
        "IAXTI_TZ"
      ]
    }
  }
}
