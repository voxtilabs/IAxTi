{
  "name": "iaxti",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "eslint .",
    "test": "turbo test",
    "migrate:deploy": "pnpm --filter @iaxti/db run build && pnpm --filter @iaxti/db run migrate",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "seed": "pnpm --filter @iaxti/seed run build && pnpm --filter @iaxti/seed run seed",
    "zavu:conectar": "node scripts/conectar-zavu.mjs",
    "catalogo": "node scripts/dump-openapi.mjs /tmp/iaxti-openapi.json && node scripts/generar-catalogo-herramientas.mjs /tmp/iaxti-openapi.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@iaxti/db": "workspace:*",
    "@iaxti/module-whatsapp": "workspace:*",
    "dependency-cruiser": "^16.8.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.40.0"
  }
}
