{
  "name": "iaxti",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "eslint .",
    "antes-de-empujar": "bash scripts/antes-de-empujar.sh",
    "test": "turbo test",
    "migrate:deploy": "pnpm --filter @iaxti/db run build && pnpm --filter @iaxti/db run migrate",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "seed": "pnpm --filter @iaxti/seed run build && pnpm --filter @iaxti/seed run seed",
    "zavu:conectar": "node scripts/conectar-zavu.mjs",
    "catalogo": "turbo build --filter=@iaxti/api && node scripts/dump-openapi.mjs /tmp/iaxti-openapi.json && node scripts/generar-catalogo-herramientas.mjs /tmp/iaxti-openapi.json",
    "columnas": "node scripts/columnas-sin-lector.mjs",
    "migraciones:virgen": "node scripts/migraciones-en-base-virgen.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iaxti/db": "workspace:*",
    "@iaxti/module-whatsapp": "workspace:*",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "turbo": "^2.11.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0"
  }
}
